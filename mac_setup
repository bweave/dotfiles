#!/bin/bash

# -e exit with any non-zero status
# -u treat unset vars as an error when substituting
set -eu

RED="\033[0;31m"
GREEN="\033[0;32m"
BLUE="\033[0;34m"
ENDCOLOR="\033[0m"

function msg() {
	echo -e "$1"
}

function info() {
	msg "$BLUE$1$ENDCOLOR"
}

function success() {
	msg "${GREEN}$1${ENDCOLOR}"
}

function error() {
	msg "${RED}$1${ENDCOLOR}"
}

info "Mac setup - enter your password to get started:"
sudo echo "Let's go!"

if [ ! "$(command -v brew)" ]; then
	info "Installing homebrew..."
	/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
success "Homebrew is g2g"

if [ ! "$(command -v gh)" ]; then
	info "Installing GitHub CLI..."
	brew install gh
fi

if ! gh auth status >/dev/null 2>&1; then
	info "Authenticating with GitHub - this also generates and uploads an SSH key if you don't have one yet:"
	gh auth login --hostname github.com --git-protocol ssh --web
fi
success "GitHub SSH access is g2g"

if [ ! -d "$HOME/dotfiles" ]; then
	info "Cloning dotfiles..."
	git clone git@github.com:bweave/dotfiles.git "$HOME/dotfiles"
fi
success "dotfiles cloned"

info "Install Homebrew packages:"
brew bundle --file "$HOME/dotfiles/Brewfile"

info "Symlinking dotfiles..."
stow --dir "$HOME/dotfiles" --target "$HOME" .
success "dotfiles are g2g"

info "Generating .secrets from 1Password..."
if command -v op >/dev/null && op inject --account planningcenter.1password.com \
	-i "$HOME/dotfiles/.secrets.tpl" -o "$HOME/.secrets" --force; then
	success ".secrets generated from 1Password"
else
	error "Couldn't reach 1Password - sign in ('op signin' or unlock the desktop app) and rerun:"
	error "  op inject --account planningcenter.1password.com -i \$HOME/dotfiles/.secrets.tpl -o \$HOME/.secrets --force"
	touch "$HOME/.secrets"
	chmod 600 "$HOME/.secrets"
fi

info "Installing neovim..."
"$HOME/dotfiles/install-neovim-nightly.sh"

defaults write -g InitialKeyRepeat -int 10 # normal minimum is 15 (225 ms)
defaults write -g KeyRepeat -int 1         # normal minimum is 2 (30 ms)
success "fast key repeat set"

# rbenv versions --bare only lists already-installed rubies, which is empty
# on a fresh machine, so offer installable versions instead.
rubies="$(rbenv install -l | grep -E '^\s*[0-9]+\.[0-9]+\.[0-9]+$')"
ruby_version=$(echo "$rubies" | fzf --prompt="Select Ruby version: " --tac)
info "Installing ruby v$ruby_version..."
rbenv install -s "$ruby_version"
rbenv global "$ruby_version"
eval "$(rbenv init - bash)"
gem install bundler rails
rbenv rehash
success "Ruby $ruby_version installed"

info "setting up NVM with Node LTS"
export NVM_DIR="$HOME/.nvm"
mkdir -p "$NVM_DIR"
# nvm is a shell function, not a binary, so it must be sourced before use.
# shellcheck disable=SC1091
. "$(brew --prefix nvm)/nvm.sh"
nvm install --lts
nvm alias system node
npm i -g \
	vscode-langservers-extracted \
	bash-language-server
success "NVM and Node are g2g"

echo
success =================================================
success "Donezo!"
success =================================================
echo
